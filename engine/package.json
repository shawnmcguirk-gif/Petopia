{
  "name": "petopia-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Petopia D1's single TypeScript engine: the household's animals, their provenance rules, roles and photos. Same shape as Vitalis: n8n never touches the petopia database.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "decimal.js": "^10.4.3",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.2"
  }
}
